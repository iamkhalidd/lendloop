# --- Next.js (.env.local) -------------------------------------------------
# Written for you by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# From the Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex deployment env (set with `npx convex env set NAME value`) -------
# Clerk → Integrations → Convex → "Frontend API URL"
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Where Convex POSTs request events (the n8n notify webhook)
# N8N_NOTIFY_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-notify
# Two different random secrets, one per direction: `openssl rand -hex 32`
# CONVEX_TO_N8N_SECRET=
# N8N_TO_CONVEX_SECRET=

# --- n8n (docker compose reads this file as .env) ---------------------------
# Your deployment's HTTP actions URL, ends in .convex.site
CONVEX_SITE_URL=
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=
